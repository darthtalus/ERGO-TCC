msgstr ""

#: templates/tasks/documentation.html:145
msgid "Team manager, can create tasks and monitor subordinate performance."
msgstr ""

#: templates/tasks/documentation.html:146
msgid "Operational profile, focused on task execution and self-assessment."
msgstr ""

