#: templates/params/dashboard_estatisticas.html:210
msgid ""
"<strong>Process:</strong> Every time a user finishes their day, a snapshot "
"of all their configured parameters (with their parametrized value 1-5) is "
"saved in the history table, linked to that day's effectiveness record."
msgstr ""

#: templates/params/dashboard_estatisticas.html:211
msgid ""
"<strong>Environment:</strong> <code>AVG(parametrized)</code> of all history "
"records where <code>dimension = ENVIRONMENT</code>."
msgstr ""

#: templates/params/dashboard_estatisticas.html:212
msgid ""
"<strong>Cognition:</strong> <code>AVG(parametrized)</code> of all history "
"records where <code>dimension = COGNITION</code>."
msgstr ""

#: templates/params/dashboard_estatisticas.html:213
msgid ""
"<strong>Behavior:</strong> <code>AVG(parametrized)</code> of all history "
"records where <code>dimension = BEHAVIOR</code>."
msgstr ""

#: templates/params/dashboard_estatisticas.html:214
msgid ""
"<strong>Note:</strong> This analysis evaluates only the executors' self-"
"assessments, as stakeholders do not evaluate the executors' dimensions."
msgstr ""

#: templates/params/dashboard_estatisticas.html:223
msgid "Evolution Analysis"
msgstr ""

#: templates/params/dashboard_estatisticas.html:224
msgid ""
"Comparison between daily perception (Logs) and objective performance in "
"tasks over time."
msgstr ""

#: templates/params/dashboard_estatisticas.html:226
msgid "Evolution Graph"
msgstr ""

#: templates/params/dashboard_estatisticas.html:233
msgid ""
"<strong>Daily Record line (blue):</strong> For each day in the period, "
"calculates the average effectiveness from <code>daily_effectiveness</code>: "
"<code>AVG(effectiveness)</code> grouped by <code>day</code>. This represents "
"the user's general daily perception."
msgstr ""

#: templates/params/dashboard_estatisticas.html:234
msgid ""
"<strong>Task Evaluation line (orange):</strong> For each day, calculates the "
"average effectiveness from <code>task_evaluation</code>: "
"<code>AVG(effectiveness)</code> grouped by <code>DATE(created_at)</code>. "
"This represents the objective task-level performance."
msgstr ""

#: templates/params/dashboard_estatisticas.html:235
msgid ""
"<strong>Interpretation:</strong> When the lines diverge significantly, it "
"indicates a gap between the user's general perception and their actual task "
"performance. Convergence suggests alignment between self-perception and "
"results."
msgstr ""

#: templates/params/dashboard_estatisticas.html:244
msgid "Statistical Summary"
msgstr ""

#: templates/params/dashboard_estatisticas.html:245
msgid "Direct quantitative analysis based on the latest generated data."
msgstr ""

#: templates/params/dashboard_estatisticas.html:254
msgid ""
"<strong>General Average Effectiveness (Daily Records):</strong> "
"<code>AVG(effectiveness)</code> from <code>daily_effectiveness</code> — the "
"mean of all end-of-day scores recorded by all users in the selected period."
msgstr ""

#: templates/params/dashboard_estatisticas.html:255
msgid ""
"<strong>Average Effectiveness (Executors):</strong> <code>AVG(effectiveness) "
"WHERE rate_type = SELF</code> from <code>task_evaluation</code>."
msgstr ""

#: templates/params/dashboard_estatisticas.html:256
msgid ""
"<strong>Average Effectiveness (Stakeholders):</strong> "
"<code>AVG(effectiveness) WHERE rate_type = STAKEHOLDER</code> from "
"<code>task_evaluation</code>."
msgstr ""

#: templates/params/dashboard_estatisticas.html:257
msgid ""
"<strong>General Average Effectiveness (Tasks):</strong> "
"<code>AVG(effectiveness)</code> from <code>task_evaluation</code> — the mean "
"of all task evaluation scores (both self and stakeholder) in the selected "
"period."
msgstr ""

#: templates/params/dashboard_estatisticas.html:258
msgid ""
"<strong>Total Task Evaluations:</strong> <code>COUNT(*)</code> from "
"<code>task_evaluation</code> — total number of task evaluation records in "
"the period."
msgstr ""

#: templates/params/dashboard_estatisticas.html:259
msgid ""
"<strong>Total Daily Records:</strong> <code>COUNT(*)</code> from "
"<code>daily_effectiveness</code> — total number of end-of-day records in the "
"period."
msgstr ""

#: templates/params/dashboard_estatisticas.html:260
msgid ""
"<strong>Average Environmental/Cognitive/Behavioral Impact:</strong> "
"<code>AVG(parametrized)</code> from <code>measurement_history</code> "
"filtered by the respective dimension — the mean of all parametrized values "
"(1-5) that users assigned to their aspects in each dimension."
msgstr ""

