#: templates/params/dashboard_estatisticas.html:190
msgid ""
"<strong>Stakeholder Evaluation:</strong> When a stakeholder evaluates an "
"executor's completed task, they also assign a score (1 to 5). The bar shows "
"the arithmetic mean of ALL stakeholder scores: <code>SUM(effectiveness) / "
"COUNT(records)</code> where <code>rate_type = STAKEHOLDER</code>."
msgstr ""

#: templates/params/dashboard_estatisticas.html:199
