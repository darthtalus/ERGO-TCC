#: templates/tasks/documentation.html:156
msgid "Task Lifecycle"
msgstr ""

#: templates/tasks/documentation.html:157
msgid ""
"Tasks are the core of ERGO. Each task goes through a lifecycle with well-"
"defined states:"
msgstr ""

#: templates/tasks/documentation.html:158
msgid "Assignment Statuses"
msgstr ""

#: templates/tasks/documentation.html:160
msgid "The task is being executed."
msgstr ""

#: templates/tasks/documentation.html:161
msgid "Temporary interruption."
msgstr ""

#: templates/tasks/documentation.html:162
msgid "Task permanently discontinued."
msgstr ""

#: templates/tasks/documentation.html:163
msgid "Completed and ready for evaluation."
msgstr ""

