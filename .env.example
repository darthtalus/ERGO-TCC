# ERGO — exemplo seguro de configuração
# Copie para .env e substitua todos os placeholders.

SECRET_KEY=CHANGE_ME
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME

# Origens confiáveis, principalmente em produção HTTPS.
CSRF_TRUSTED_ORIGINS=

# SMTP opcional: convites, redefinição de senha e notificações.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ERGO <noreply@example.com>
EMAIL_REPLY_TO=

# Armazenamento privado de anexos. O padrão é BASE_DIR/private_media.
PRIVATE_MEDIA_ROOT=

# Mantenha identidades ocultas nos links públicos, salvo decisão formal.
PUBLIC_SHARE_SHOW_PARTICIPANT_NAMES=False
